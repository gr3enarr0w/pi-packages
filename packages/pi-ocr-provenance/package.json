{
  "name": "@gr3enarr0w/pi-ocr-provenance",
  "version": "0.1.0",
  "description": "Pi skills and direct-tool profiles for the OCR Provenance MCP server.",
  "type": "module",
  "imports": {
    "#profiles/*": "./profiles/*.json",
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "files": [
    "src",
    "skills",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ocr",
    "provenance",
    "mcp",
    "document-ai"
  ],
  "author": {
    "name": "Clark Everson"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gr3enarr0w/pi-packages.git",
    "directory": "packages/pi-ocr-provenance"
  },
  "homepage": "https://github.com/gr3enarr0w/pi-packages/tree/main/packages/pi-ocr-provenance#readme",
  "bugs": {
    "url": "https://github.com/gr3enarr0w/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check *.md skills/**/*.md",
    "lint": "biome check . && eslint . && pnpm run lint:md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.75.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@types/node": "catalog:",
    "rumdl": "catalog:",
    "typebox": "^1.2.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
